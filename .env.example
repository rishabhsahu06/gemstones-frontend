# NextAuth (required on deploy — use your live domain)
NEXTAUTH_URL=https://your-production-domain.com
NEXTAUTH_SECRET=generate_a_long_random_string

# Backend API (must expose POST /auth/mobile-user for OTP → cart JWT)
NEXT_PUBLIC_API_URL=https://gemstone-backend.vercel.app/

# MSG91 OTP Widget
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_WIDGET_TOKEN=
MSG91_WIDGET_ID=
MSG91_AUTH_KEY=
